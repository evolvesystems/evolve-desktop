{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "identifier": "default",
  "description": "Default capabilities for EvolveApp dual-webview architecture",
  "windows": ["main", "quick-send"],
  "webviews": ["sidebar", "content", "main", "quick-send"],
  "remote": {
    "urls": [
      "https://evolvepreneuriq.app/*",
      "https://*.evolvepreneuriq.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-center",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-inner-size",
    "core:webview:allow-create-webview",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-webview-close",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",
    "core:app:allow-version",
    "allow-get-app-version",
    "allow-save-cached-tabs",
    "allow-load-cached-tabs",
    "allow-navigate-content",
    "allow-get-content-url",
    "allow-content-go-back",
    "allow-content-reload",
    "allow-toggle-sidebar-config",
    "allow-show-info-modal",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-save-tabs-via-content",
    "allow-relay-tabs-to-sidebar",
    "allow-relay-badges-to-sidebar",
    "allow-open-external-url",
    "allow-offline-cache-put",
    "allow-offline-cache-get",
    "allow-offline-cache-clear",
    "allow-close-quick-send",
    "shell:default",
    "http:default"
  ]
}
